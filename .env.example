# Copy this file to .env.local and fill in the values.

# Public URL of the site (no trailing slash). Used for SEO, sitemap and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional starting value for the shop's WhatsApp number (91 + 10 digits). The real number is
# set in Admin → Settings, which overrides this.
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Any long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me-to-a-long-random-string

# Optional: Google Search Console → Settings → Ownership verification → HTML tag → content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Secret used to hash IPs for rate limiting (any long random string; set a different one per environment)
RATE_LIMIT_SALT=
